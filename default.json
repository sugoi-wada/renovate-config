{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    ":separateMultipleMajorReleases",
    ":timezone(Asia/Tokyo)",
    ":prHourlyLimitNone"
  ],
  "automergeSchedule": [
    "after 11am and before 11pm every weekend"
  ],
  "platformAutomerge": false,
  "labels": [
    "dependencies"
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ],
    "automerge": true
  },
  "pin": {
    "automerge": true
  },
  "packageRules": [
    {
      "description": "GitHub Actions はタグではなくコミット SHA で固定する（タグ付け替えによるサプライチェーン汚染対策）。バージョンはコメントとして併記され、更新は通常のルールに従う。",
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true
    }
  ],
  "major": {
    "addLabels": [
      "UPDATE-MAJOR"
    ],
    "stabilityDays": 7
  },
  "minor": {
    "stabilityDays": 5,
    "automerge": true
  },
  "patch": {
    "stabilityDays": 2,
    "automerge": true
  },
  "pip_requirements": {
    "fileMatch": [
      "^requirements([-|_]?[a-z]*)\\.(txt|pip)$"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "postUpdateOptions": [
    "yarnDedupeHighest"
  ]
}
